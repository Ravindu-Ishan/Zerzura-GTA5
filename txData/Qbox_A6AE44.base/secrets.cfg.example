# Copy this file to "secrets.cfg" in this same folder and fill in your own values.
# secrets.cfg is gitignored — never commit real credentials there.

# Your personal license key from https://keymaster.fivem.net/ (one per operator/machine)
sv_licenseKey "changeme"

# Your local MariaDB/MySQL connection string
set mysql_connection_string "mysql://user:password@localhost/database_name?charset=utf8mb4"
